{
  "name": "kalima",
  "author": "chairulakmal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "docker compose up -d && nuxt dev",
    "build": "nuxt build",
    "start": "npx prisma db push --accept-data-loss && npx prisma db seed && node .output/server/index.mjs",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "nuxt prepare",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:seed": "tsx prisma/seed.ts",
    "generate:seed": "tsx scripts/generate-seed.ts",
    "deploy": "railway up -d --service kalima",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@pinia/nuxt": "^1.0.1",
    "@prisma/client": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "nuxt": "^4.4.8",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.5.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
